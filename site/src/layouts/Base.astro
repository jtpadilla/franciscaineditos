---
import '../styles/global.css';
import { Font, getImage } from 'astro:assets';
import boda from '../../../md/Memoria familiar/Fotos antiguas/img/boda.jpeg';
import { SITE, T, GERMANS, CODI_IDIOMA, url, type Lang } from '../site/config';
interface Props { lang: Lang; title?: string; desc?: string; ruta?: string; actual?: 'obres' | 'fotografies' | 'cerca' | 'sobre' | 'autora'; }
const { lang, title, desc, ruta = '', actual } = Astro.props;
const altre: Lang = lang === 'ca' ? 'es' : 'ca';
const titol = title ? `${title} · ${SITE.nom[lang]}` : `${SITE.nom[lang]} · ${SITE.autora}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonica = new URL(url(lang, ruta), Astro.site);
// Imatge per a xarxes (Open Graph): la boda de cap a 1940 davant de la casa Santjoans, la mateixa que
// identifica este projecte a l'índex franciscajulianquerol, retallada a 1200×630 en construir.
const og = await getImage({ src: boda, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogImatge = new URL(og.src, Astro.site).href;
const ogAlt = lang === 'ca' ? 'Una boda a Cinctorres cap a 1940, davant de la casa Santjoans' : 'Una boda en Cinctorres hacia 1940, delante de la casa Santjoans';
---
<html lang={CODI_IDIOMA[lang]}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titol}</title>
  <meta name="description" content={desc ?? SITE.lema[lang]} />
  <meta name="author" content={SITE.autora} />
  <meta name="color-scheme" content="light dark" />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <link rel="alternate" hreflang={CODI_IDIOMA[altre]} href={new URL(url(altre, ruta), Astro.site)} />
  <link rel="canonical" href={canonica} />
  <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={`${SITE.nom[lang]} · ${SITE.autora}`} />
  <meta property="og:title" content={titol} />
  <meta property="og:description" content={desc ?? SITE.lema[lang]} />
  <meta property="og:url" content={canonica} />
  <meta property="og:locale" content={lang === 'ca' ? 'ca_ES' : 'es_ES'} />
  <meta property="og:image" content={ogImatge} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ogAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <Font cssVariable="--f-lectura" preload /><Font cssVariable="--f-ui" />
  <script is:inline>try { const t = localStorage.getItem('tema'); if (t) document.documentElement.dataset.theme = t; } catch {}</script>
</head>
<body>
  <header class="capçalera"><div class="cap">
    <a class="marca" href={url(lang)}>{SITE.nom[lang]}<small>{SITE.autora}</small></a>
    <nav class="principal" aria-label="Principal">
      <a href={url(lang)} aria-current={actual === 'obres' ? 'page' : undefined}>{T.obres[lang]}</a>
      <a href={url(lang, 'fotografies')} aria-current={actual === 'fotografies' ? 'page' : undefined}>{T.fotografies[lang]}</a>
      <a href={url(lang, 'cerca')} aria-current={actual === 'cerca' ? 'page' : undefined}>{T.cerca[lang]}</a>
      <a href={url(lang, 'autora')} aria-current={actual === 'autora' ? 'page' : undefined}>{T.autora[lang]}</a>
      <a href={url(lang, 'sobre')} aria-current={actual === 'sobre' ? 'page' : undefined}>{T.sobre[lang]}</a>
      <a class="idioma" href={url(altre, ruta)} lang={CODI_IDIOMA[altre]} hreflang={CODI_IDIOMA[altre]}>{T.idiomaAlt[lang]}</a>
      <button id="tema-boto" type="button" class="tema" aria-label={T.tema[lang]} title={T.tema[lang]}>◐</button>
    </nav>
  </div></header>
  <main><div class="cap"><slot /></div></main>
  <footer class="peu"><div class="cap">
    <p class="avis-peu">{T.peu[lang]} <a href={SITE.repositori}>{T.repositori[lang]}</a>.</p>
    <p class="lbl">{T.altresLlocs[lang]}</p>
    <ul>{GERMANS.map((g) => <li><a href={g.url}>{g.nom}</a> <span>— {g.desc[lang]}</span></li>)}</ul>
  </div></footer>
  <dialog class="visor" aria-label="Imatge ampliada">
    <figure style="margin:0"><img alt="" /><figcaption></figcaption></figure>
    <button class="anterior" type="button" aria-label="Anterior" hidden>‹</button>
    <button class="seguent" type="button" aria-label="Següent" hidden>›</button>
    <button class="tancar" type="button" aria-label="Tanca">×</button>
  </dialog>
  <script>
    document.getElementById('tema-boto')?.addEventListener('click', () => {
      const root = document.documentElement;
      const dark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      root.dataset.theme = dark ? 'light' : 'dark';
      try { localStorage.setItem('tema', root.dataset.theme); } catch {}
    });
    // Visor: el mateix que el de «Les meues coses». El peu es copia amb el seu HTML, així que a la
    // galeria l'enllaç al text on apareix la foto continua funcionant dins de la imatge ampliada; i es
    // pot passar a la foto següent amb les fletxes, el teclat o lliscant amb el dit.
    const v = document.querySelector<HTMLDialogElement>('dialog.visor');
    const g = v?.querySelector('img'); const c = v?.querySelector('figcaption');
    const anterior = v?.querySelector<HTMLButtonElement>('.anterior'); const seguent = v?.querySelector<HTMLButtonElement>('.seguent');
    if (v && g && c && anterior && seguent) {
      const fotos = [...document.querySelectorAll<HTMLImageElement>('.lectura img, .galeria img')];
      let actual = 0;
      const mostra = (i: number) => {
        actual = (i + fotos.length) % fotos.length;
        const img = fotos[actual];
        g.src = img.dataset.gran || img.currentSrc || img.src; g.alt = img.alt;
        c.innerHTML = img.closest('figure')?.querySelector('figcaption')?.innerHTML ?? '';
        anterior.hidden = seguent.hidden = fotos.length < 2;
      };
      fotos.forEach((img, i) => { img.style.cursor = 'zoom-in'; img.addEventListener('click', () => { mostra(i); v.showModal(); }); });
      anterior.addEventListener('click', (e) => { e.stopPropagation(); mostra(actual - 1); });
      seguent.addEventListener('click', (e) => { e.stopPropagation(); mostra(actual + 1); });
      v.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') { e.preventDefault(); mostra(actual - 1); }
        if (e.key === 'ArrowRight') { e.preventDefault(); mostra(actual + 1); }
      });
      // Lliscar amb el dit: només si el gest és clarament horitzontal, per a no robar-li l'scroll.
      let x0 = 0, y0 = 0;
      v.addEventListener('touchstart', (e) => { x0 = e.changedTouches[0].clientX; y0 = e.changedTouches[0].clientY; }, { passive: true });
      v.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) mostra(actual + (dx < 0 ? 1 : -1));
      }, { passive: true });
      v.querySelector('.tancar')?.addEventListener('click', () => v.close());
      v.addEventListener('click', (e) => { const t = e.target as HTMLElement; if (t === v || t.tagName === 'FIGURE') v.close(); });
      v.addEventListener('close', () => g.removeAttribute('src'));
    }
  </script>
</body>
</html>
